import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { vi, describe, test, expect, beforeEach } from 'vitest';
import { ImageToVideoConverter } from '../../src/ImageToVideoConverter';

// Mock the logo import
vi.mock('/assets/logo.png', () => ({
  default: 'mocked-logo-url',
}));

describe('ImageToVideoConverter', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  describe('Initial Render', () => {
    test('renders upload area when no images', () => {
      render(<ImageToVideoConverter />);
      
      expect(screen.getByText('Drop images here')).toBeInTheDocument();
      expect(screen.getByText('or click to browse')).toBeInTheDocument();
      expect(screen.getByRole('button', { name: /browse files/i })).toBeInTheDocument();
    });

    test('renders logo and title', () => {
      render(<ImageToVideoConverter />);
      
      expect(screen.getByAltText('Stills-2-Video Logo')).toBeInTheDocument();
      expect(screen.getByText('A Simple Image Sequence to Video Converter')).toBeInTheDocument();
      expect(screen.getByText('Drop images, arrange them, and export as video')).toBeInTheDocument();
    });

    test('does not show settings or image grid initially', () => {
      render(<ImageToVideoConverter />);
      
      expect(screen.queryByText('Settings')).not.toBeInTheDocument();
      expect(screen.queryByText('Images (0)')).not.toBeInTheDocument();
    });
  });

  describe('File Upload', () => {
    test('handles file input change', async () => {
      const user = userEvent.setup();
      render(<ImageToVideoConverter />);
      
      const file = new File(['test'], 'test.jpg', { type: 'image/jpeg' });
      const input = screen.getByRole('button', { name: /browse files/i });
      
      await user.click(input);
      
      // Simulate file selection
      const fileInput = document.querySelector('input[type="file"]') as HTMLInputElement;
      fireEvent.change(fileInput, { target: { files: [file] } });
      
      await waitFor(() => {
        expect(screen.getByText('Settings')).toBeInTheDocument();
      });
    });

    test('handles drag and drop events', async () => {
      render(<ImageToVideoConverter />);
      
      const dropZone = screen.getByText('Drop images here').closest('div');
      const file = new File(['test'], 'test.jpg', { type: 'image/jpeg' });
      
      // Test drag over
      fireEvent.dragOver(dropZone!);
      
      // Test drop
      fireEvent.drop(dropZone!, {
        dataTransfer: {
          files: [file],
        },
      });
      
      await waitFor(() => {
        expect(screen.getByText('Settings')).toBeInTheDocument();
      });
    });

    test('prevents default on drag over', () => {
      render(<ImageToVideoConverter />);
      
      const dropZone = screen.getByText('Drop images here').closest('div');
      const preventDefault = vi.fn();
      
      fireEvent.dragOver(dropZone!, { preventDefault });
      
      expect(preventDefault).toHaveBeenCalled();
    });
  });

  describe('Settings Panel', () => {
    beforeEach(async () => {
      render(<ImageToVideoConverter />);
      
      // Add an image to show settings
      const file = new File(['test'], 'test.jpg', { type: 'image/jpeg' });
      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files: [file] },
      });
      
      await waitFor(() => {
        expect(screen.getByText('Settings')).toBeInTheDocument();
      });
    });

    test('shows all setting controls', () => {
      expect(screen.getByLabelText(/sort order/i)).toBeInTheDocument();
      expect(screen.getByLabelText(/video codec/i)).toBeInTheDocument();
      expect(screen.getByLabelText(/frames per second/i)).toBeInTheDocument();
      expect(screen.getByLabelText(/video width/i)).toBeInTheDocument();
      expect(screen.getByLabelText(/video height/i)).toBeInTheDocument();
    });

    test('shows image count and duration', () => {
      expect(screen.getByText(/1 images/)).toBeInTheDocument();
      expect(screen.getByText(/Video duration:/)).toBeInTheDocument();
    });

    test('enables generate button when images are present', () => {
      const generateButton = screen.getByRole('button', { name: /generate video/i });
      expect(generateButton).not.toBeDisabled();
    });

    test('updates sort order when changed', async () => {
      const user = userEvent.setup();
      const sortSelect = screen.getByLabelText(/sort order/i);
      
      await user.selectOptions(sortSelect, 'name');
      expect(sortSelect).toHaveValue('name');
    });

    test('updates FPS when changed', async () => {
      const user = userEvent.setup();
      const fpsInput = screen.getByLabelText(/frames per second/i);
      
      await user.clear(fpsInput);
      await user.type(fpsInput, '30');
      expect(fpsInput).toHaveValue(30);
    });

    test('updates video dimensions when changed', async () => {
      const user = userEvent.setup();
      const widthInput = screen.getByLabelText(/video width/i);
      const heightInput = screen.getByLabelText(/video height/i);
      
      await user.clear(widthInput);
      await user.type(widthInput, '1280');
      expect(widthInput).toHaveValue(1280);
      
      await user.clear(heightInput);
      await user.type(heightInput, '720');
      expect(heightInput).toHaveValue(720);
    });
  });

  describe('Image Grid', () => {
    beforeEach(async () => {
      render(<ImageToVideoConverter />);
      
      // Add multiple images
      const files = [
        new File(['test1'], 'a.jpg', { type: 'image/jpeg' }),
        new File(['test2'], 'b.jpg', { type: 'image/jpeg' }),
        new File(['test3'], 'c.jpg', { type: 'image/jpeg' }),
      ];
      
      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files },
      });
      
      await waitFor(() => {
        expect(screen.getByText('Images (3)')).toBeInTheDocument();
      });
    });

    test('displays all uploaded images', () => {
      expect(screen.getByText('a.jpg')).toBeInTheDocument();
      expect(screen.getByText('b.jpg')).toBeInTheDocument();
      expect(screen.getByText('c.jpg')).toBeInTheDocument();
    });

    test('shows image count in header', () => {
      expect(screen.getByText('Images (3)')).toBeInTheDocument();
    });

    test('removes individual images', async () => {
      const user = userEvent.setup();
      const removeButtons = screen.getAllByRole('button', { name: '×' });
      
      await user.click(removeButtons[0]);
      
      await waitFor(() => {
        expect(screen.getByText('Images (2)')).toBeInTheDocument();
      });
    });

    test('clears all images', async () => {
      const user = userEvent.setup();
      const clearButton = screen.getByRole('button', { name: /clear all/i });
      
      await user.click(clearButton);
      
      await waitFor(() => {
        expect(screen.queryByText('Images (3)')).not.toBeInTheDocument();
        expect(screen.queryByText('Settings')).not.toBeInTheDocument();
      });
    });

    test('sorts images when sort option changes', async () => {
      const user = userEvent.setup();
      const sortSelect = screen.getByLabelText(/sort order/i);
      
      // Change to alphabetical sort
      await user.selectOptions(sortSelect, 'name');
      
      // Check that images are now in alphabetical order
      const imageNames = screen.getAllByText(/\.jpg$/);
      expect(imageNames[0]).toHaveTextContent('a.jpg');
      expect(imageNames[1]).toHaveTextContent('b.jpg');
      expect(imageNames[2]).toHaveTextContent('c.jpg');
    });
  });

  describe('Video Generation', () => {
    beforeEach(async () => {
      render(<ImageToVideoConverter />);
      
      // Add an image
      const file = new File(['test'], 'test.jpg', { type: 'image/jpeg' });
      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files: [file] },
      });
      
      await waitFor(() => {
        expect(screen.getByText('Settings')).toBeInTheDocument();
      });
    });

    test('shows loading state during generation', async () => {
      const user = userEvent.setup();
      const generateButton = screen.getByRole('button', { name: /generate video/i });
      
      await user.click(generateButton);
      
      expect(screen.getByText('Generating...')).toBeInTheDocument();
    });

    test('disables generate button when no images', async () => {
      const user = userEvent.setup();
      const clearButton = screen.getByRole('button', { name: /clear all/i });
      
      await user.click(clearButton);
      
      await waitFor(() => {
        const generateButton = screen.getByRole('button', { name: /generate video/i });
        expect(generateButton).toBeDisabled();
      });
    });
  });

  describe('Error Handling', () => {
    test('handles invalid file types gracefully', async () => {
      render(<ImageToVideoConverter />);
      
      const dropZone = screen.getByText('Drop images here').closest('div');
      const textFile = new File(['test'], 'test.txt', { type: 'text/plain' });
      
      fireEvent.drop(dropZone!, {
        dataTransfer: { files: [textFile] },
      });
      
      // Should not show settings panel for invalid files
      await waitFor(() => {
        expect(screen.queryByText('Settings')).not.toBeInTheDocument();
      });
    });
  });
}); 