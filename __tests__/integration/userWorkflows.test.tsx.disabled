import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { vi, describe, test, expect, beforeEach } from 'vitest';
import { ImageToVideoConverter } from '../../src/ImageToVideoConverter';

// Mock the logo import
vi.mock('/assets/logo.png', () => ({
  default: 'mocked-logo-url',
}));

describe('User Workflows', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  describe('Complete Workflow: Upload → Sort → Generate → Download', () => {
    test('should complete full workflow successfully', async () => {
      const user = userEvent.setup();
      render(<ImageToVideoConverter />);

      // Step 1: Upload images
      const files = [
        new File(['test1'], 'image1.jpg', { type: 'image/jpeg' }),
        new File(['test2'], 'image2.jpg', { type: 'image/jpeg' }),
        new File(['test3'], 'image3.jpg', { type: 'image/jpeg' }),
      ];

      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files },
      });

      // Verify images are uploaded
      await waitFor(() => {
        expect(screen.getByText('Images (3)')).toBeInTheDocument();
        expect(screen.getByText('image1.jpg')).toBeInTheDocument();
        expect(screen.getByText('image2.jpg')).toBeInTheDocument();
        expect(screen.getByText('image3.jpg')).toBeInTheDocument();
      });

      // Step 2: Change sort order
      const sortSelect = screen.getByLabelText(/sort order/i);
      await user.selectOptions(sortSelect, 'name');

      // Verify sorting worked
      const imageNames = screen.getAllByText(/image\d\.jpg$/);
      expect(imageNames[0]).toHaveTextContent('image1.jpg');
      expect(imageNames[1]).toHaveTextContent('image2.jpg');
      expect(imageNames[2]).toHaveTextContent('image3.jpg');

      // Step 3: Adjust settings
      const fpsInput = screen.getByLabelText(/frames per second/i);
      await user.clear(fpsInput);
      await user.type(fpsInput, '30');

      const widthInput = screen.getByLabelText(/video width/i);
      await user.clear(widthInput);
      await user.type(widthInput, '1280');

      const heightInput = screen.getByLabelText(/video height/i);
      await user.clear(heightInput);
      await user.type(heightInput, '720');

      // Step 4: Generate video
      const generateButton = screen.getByRole('button', { name: /generate video/i });
      await user.click(generateButton);

      // Verify loading state
      expect(screen.getByText('Generating...')).toBeInTheDocument();

      // Wait for generation to complete
      await waitFor(() => {
        expect(screen.getByText('Generate Video')).toBeInTheDocument();
      }, { timeout: 5000 });
    });
  });

  describe('Drag and Drop Reordering', () => {
    test('should reorder images via drag and drop', async () => {
      render(<ImageToVideoConverter />);

      // Upload images
      const files = [
        new File(['test1'], 'first.jpg', { type: 'image/jpeg' }),
        new File(['test2'], 'second.jpg', { type: 'image/jpeg' }),
        new File(['test3'], 'third.jpg', { type: 'image/jpeg' }),
      ];

      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files },
      });

      await waitFor(() => {
        expect(screen.getByText('Images (3)')).toBeInTheDocument();
      });

      // Set to manual sort mode
      const sortSelect = screen.getByLabelText(/sort order/i);
      fireEvent.change(sortSelect, { target: { value: 'manual' } });

      // Simulate drag and drop reordering
      const imageContainers = screen.getAllByText(/\.jpg$/).map(el => el.closest('[draggable]'));
      
      // Drag first image to third position
      fireEvent.dragStart(imageContainers[0]!);
      fireEvent.dragOver(imageContainers[2]!);
      fireEvent.drop(imageContainers[2]!);
      fireEvent.dragEnd(imageContainers[0]!);

      // Verify reordering (this would need more sophisticated testing in a real scenario)
      await waitFor(() => {
        const imageNames = screen.getAllByText(/\.jpg$/);
        expect(imageNames).toHaveLength(3);
      });
    });
  });

  describe('Video Generation with Different Codecs', () => {
    test('should handle different video codec selections', async () => {
      const user = userEvent.setup();
      render(<ImageToVideoConverter />);

      // Upload an image
      const file = new File(['test'], 'test.jpg', { type: 'image/jpeg' });
      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files: [file] },
      });

      await waitFor(() => {
        expect(screen.getByText('Settings')).toBeInTheDocument();
      });

      // Test different codec selections
      const codecSelect = screen.getByLabelText(/video codec/i);
      
      // Select H.264
      await user.selectOptions(codecSelect, 'video/mp4;codecs=h264');
      expect(codecSelect).toHaveValue('video/mp4;codecs=h264');

      // Select VP9
      await user.selectOptions(codecSelect, 'video/webm;codecs=vp9');
      expect(codecSelect).toHaveValue('video/webm;codecs=vp9');

      // Select VP8
      await user.selectOptions(codecSelect, 'video/webm;codecs=vp8');
      expect(codecSelect).toHaveValue('video/webm;codecs=vp8');
    });
  });

  describe('Error Handling Workflows', () => {
    test('should handle mixed valid and invalid files', async () => {
      render(<ImageToVideoConverter />);

      const files = [
        new File(['test1'], 'valid.jpg', { type: 'image/jpeg' }),
        new File(['test2'], 'invalid.txt', { type: 'text/plain' }),
        new File(['test3'], 'valid.png', { type: 'image/png' }),
      ];

      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files },
      });

      // Should only process valid image files
      await waitFor(() => {
        expect(screen.getByText('Images (2)')).toBeInTheDocument();
        expect(screen.getByText('valid.jpg')).toBeInTheDocument();
        expect(screen.getByText('valid.png')).toBeInTheDocument();
        expect(screen.queryByText('invalid.txt')).not.toBeInTheDocument();
      });
    });

    test('should handle empty file selection', async () => {
      const user = userEvent.setup();
      render(<ImageToVideoConverter />);

      const browseButton = screen.getByRole('button', { name: /browse files/i });
      await user.click(browseButton);

      // Simulate empty file selection
      const fileInput = document.querySelector('input[type="file"]') as HTMLInputElement;
      fireEvent.change(fileInput, { target: { files: [] } });

      // Should not show settings panel
      await waitFor(() => {
        expect(screen.queryByText('Settings')).not.toBeInTheDocument();
      });
    });
  });

  describe('Memory Management Workflows', () => {
    test('should clean up object URLs when removing images', async () => {
      const user = userEvent.setup();
      render(<ImageToVideoConverter />);

      // Upload images
      const files = [
        new File(['test1'], 'image1.jpg', { type: 'image/jpeg' }),
        new File(['test2'], 'image2.jpg', { type: 'image/jpeg' }),
      ];

      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files },
      });

      await waitFor(() => {
        expect(screen.getByText('Images (2)')).toBeInTheDocument();
      });

      // Remove one image
      const removeButtons = screen.getAllByRole('button', { name: '×' });
      await user.click(removeButtons[0]);

      // Verify URL.revokeObjectURL was called
      expect(global.URL.revokeObjectURL).toHaveBeenCalled();

      // Clear all images
      const clearButton = screen.getByRole('button', { name: /clear all/i });
      await user.click(clearButton);

      // Verify more URL.revokeObjectURL calls
      expect(global.URL.revokeObjectURL).toHaveBeenCalledTimes(3); // 2 for individual removal + 1 for clear all
    });
  });

  describe('Settings Persistence', () => {
    test('should maintain settings when adding/removing images', async () => {
      const user = userEvent.setup();
      render(<ImageToVideoConverter />);

      // Upload initial image
      const file1 = new File(['test1'], 'image1.jpg', { type: 'image/jpeg' });
      const dropZone = screen.getByText('Drop images here').closest('div');
      fireEvent.drop(dropZone!, {
        dataTransfer: { files: [file1] },
      });

      await waitFor(() => {
        expect(screen.getByText('Settings')).toBeInTheDocument();
      });

      // Change settings
      const fpsInput = screen.getByLabelText(/frames per second/i);
      await user.clear(fpsInput);
      await user.type(fpsInput, '15');

      const widthInput = screen.getByLabelText(/video width/i);
      await user.clear(widthInput);
      await user.type(widthInput, '800');

      // Remove all images
      const clearButton = screen.getByRole('button', { name: /clear all/i });
      await user.click(clearButton);

      // Add new image
      const file2 = new File(['test2'], 'image2.jpg', { type: 'image/jpeg' });
      fireEvent.drop(dropZone!, {
        dataTransfer: { files: [file2] },
      });

      await waitFor(() => {
        expect(screen.getByText('Settings')).toBeInTheDocument();
      });

      // Verify settings are maintained
      expect(screen.getByLabelText(/frames per second/i)).toHaveValue(15);
      expect(screen.getByLabelText(/video width/i)).toHaveValue(800);
    });
  });
}); 